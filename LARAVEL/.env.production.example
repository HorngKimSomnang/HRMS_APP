# Laravel — PRODUCTION env values that DIFFER from local dev.
# These are the keys you must review/change when deploying to AWS.
# Merge these into the real .env you create on the server (from .env.example),
# then run: php artisan key:generate && php artisan config:cache

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# PostgreSQL on the server (localhost if DB runs on the same EC2 box)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=HRMS
DB_USERNAME=hrms
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS: origin(s) the browser panel is served from. No trailing slash.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Sanctum: hosts allowed to make stateful requests (mobile uses bearer tokens,
# so this mainly matters for the web panel if you use cookie auth).
SANCTUM_STATEFUL_DOMAINS=your-domain.com

# Serve over HTTPS
SESSION_SECURE_COOKIE=true
